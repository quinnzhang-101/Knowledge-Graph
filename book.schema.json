{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-scribe.local/schemas/v1/book.schema.json",
  "title": "Book",
  "description": "Original knowledge source. Not the distillation result.",
  "type": "object",
  "required": ["book_id", "title", "authors", "language", "book_type"],
  "additionalProperties": false,
  "properties": {
    "book_id": {
      "type": "string",
      "pattern": "^book:[a-z0-9-]+$"
    },
    "title": {"type": "string", "minLength": 1},
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "language": {
      "type": "string",
      "description": "BCP 47 language tag, e.g. zh-CN, en-US",
      "pattern": "^[a-z]{2}-[A-Z]{2}$"
    },
    "book_type": {
      "type": "string",
      "minLength": 1
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "year": {"type": "integer", "minimum": 0}
      }
    }
  }
}
