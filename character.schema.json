{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-scribe.local/schemas/v1/character.schema.json",
  "title": "Character (Book-local Entity)",
  "description": "Person/organization/place/etc. extracted from one book. ID is book-local; global entity resolution is deferred.",
  "type": "object",
  "required": ["entity_id", "entity_type", "canonical_name", "source_book_id", "evidence_refs"],
  "additionalProperties": false,
  "properties": {
    "entity_id": {
      "type": "string",
      "description": "Format: entity:book:<book_slug>:<entity_type>:<person_slug>",
      "pattern": "^entity:book:[a-z0-9-]+:[a-z]+:[a-z0-9-]+$"
    },
    "entity_type": {
      "enum": ["person", "organization", "place", "group", "concept", "other"]
    },
    "canonical_name": {"type": "string", "minLength": 1},
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "source_book_id": {
      "type": "string",
      "pattern": "^book:[a-z0-9-]+$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "evidence_ref.schema.json"}
    }
  }
}
