{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-scribe.local/schemas/v1/causal.schema.json",
  "title": "Causal Chain",
  "description": "Edge between two events. Avoids single-cause fallacy: prefer contributed_to over caused.",
  "type": "object",
  "required": [
    "causal_id", "cause", "effect", "relation",
    "claim", "epistemic_status", "evidence_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "causal_id": {
      "type": "string",
      "pattern": "^causal:book:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "cause": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["event"]},
        "ref": {
          "type": "string",
          "pattern": "^event:book:[a-z0-9-]+:[a-z0-9-]+$"
        }
      }
    },
    "effect": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["event"]},
        "ref": {
          "type": "string",
          "pattern": "^event:book:[a-z0-9-]+:[a-z0-9-]+$"
        }
      }
    },
    "relation": {
      "enum": ["contributed_to", "precipitated", "enabled", "inhibited", "was_consequence_of"]
    },
    "claim": {"type": "string", "minLength": 1},
    "epistemic_status": {
      "enum": ["source_fact", "author_claim", "model_extraction",
               "model_interpretation", "uncertain"]
    },
    "source_book_id": {
      "type": "string",
      "pattern": "^book:[a-z0-9-]+$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "evidence_ref.schema.json"}
    }
  }
}
