{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-scribe.local/schemas/v1/context.schema.json",
  "title": "Context",
  "description": "Author-provided background knowledge. Traces to book evidence (evidence_refs), not to other Package objects. NOT a conclusion; background only.",
  "type": "object",
  "required": [
    "context_id", "title", "content",
    "source_book_id", "evidence_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "context_id": {
      "type": "string",
      "pattern": "^context:book:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "title": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "source_book_id": {
      "type": "string",
      "pattern": "^book:[a-z0-9-]+$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "evidence_ref.schema.json"}
    }
  }
}
